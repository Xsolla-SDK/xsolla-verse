{
  "version": "1.0.0",
  "main": "./server.js",
  "scripts": {
    "dev:server": "nodemon ./server",
    "start": "node scripts/start-all.js",
    "start:backend": "node ./server",
    "start:frontend": "npm install --prefix client && npm start --prefix client",
    "dev": "npx --yes concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "test:game": "jest --testPathPatterns=game/__tests__ --forceExit",
    "test:contracts": "npm test --prefix chain",
    "compile": "npm run compile --prefix chain",
    "deploy:local": "npm run deploy:local --prefix chain",
    "deploy:amoy": "npm run deploy:amoy --prefix chain",
    "deploy:polygon": "npm run deploy:polygon --prefix chain",
    "node": "npm run node --prefix chain"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongoose": "^9.9.3",
    "multer": "^2.0.2",
    "pokersolver": "^2.1.4",
    "socket.io": "^4.8.1",
    "underscore": "^1.13.7",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/contracts": "^5.4.0",
    "chai": "^6.2.2",
    "concurrently": "^10.0.5",
    "core-js": "^3.50.0",
    "hardhat": "^3.13.0",
    "jest": "^30.4.2",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.10",
    "raf": "^3.4.1",
    "typescript": "^5.9.2"
  }
}
