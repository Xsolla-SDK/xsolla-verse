# Local: leave empty so Vite proxies /api and /socket.io.
# Production: set VITE_SERVER_URI in netlify.toml [build.environment], not the Netlify UI.

# Public URL of the Express + Socket.IO hub (no trailing slash).
VITE_SERVER_URI=

# Wallet / chain (defaults match local Hardhat).
# VITE_CHAIN_ID=80002
# VITE_RPC_URL=https://rpc-amoy.polygon.technology
# VITE_CHAIN_NAME=Polygon Amoy
# VITE_NATIVE_NAME=POL
# VITE_NATIVE_SYMBOL=POL
